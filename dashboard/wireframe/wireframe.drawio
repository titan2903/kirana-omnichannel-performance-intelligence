<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram name="1. Executive Overview" id="kirana_executive"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1380" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Executive Overview: apakah penjualan dan margin berada di jalur target? [heading]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="30" width="956" height="30" as="geometry"/></mxCell><mxCell id="c3" value="**Cara membaca.** Filter *Periode, Channel, Region, Kategori* berlaku untuk semua kartu ya [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="812" width="956" height="64" as="geometry"/></mxCell><mxCell id="c4" value="Kesegaran data dan status sinkronisasi POS [table]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="64" width="956" height="98" as="geometry"/></mxCell><mxCell id="c5" value="Penanda data tidak lengkap per toko-bulan [table]  (P)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="642" width="476" height="166" as="geometry"/></mxCell><mxCell id="c6" value="Achievement vs Target [gauge]  (PCR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="166" width="156" height="98" as="geometry"/></mxCell><mxCell id="c7" value="Pencapaian terhadap target per channel [table]  (PCR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="268" width="476" height="166" as="geometry"/></mxCell><mxCell id="c8" value="Average Order Value [scalar]  (PCR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="810" y="166" width="156" height="98" as="geometry"/></mxCell><mxCell id="c9" value="Contribution Margin [scalar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="166" width="156" height="98" as="geometry"/></mxCell><mxCell id="c10" value="Gross dan Contribution Margin bulanan (%) [line]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="642" width="476" height="166" as="geometry"/></mxCell><mxCell id="c11" value="Gross Margin [scalar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="166" width="156" height="98" as="geometry"/></mxCell><mxCell id="c12" value="Margin terhadap target per channel [table]  (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="268" width="476" height="166" as="geometry"/></mxCell><mxCell id="c13" value="Net Sales [scalar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="166" width="156" height="98" as="geometry"/></mxCell><mxCell id="c14" value="Net Sales bulanan per channel (Rp miliar) [bar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="438" width="476" height="200" as="geometry"/></mxCell><mxCell id="c15" value="Net Sales vs Target bulanan (Rp miliar) [line]  (PCR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="438" width="476" height="200" as="geometry"/></mxCell><mxCell id="c16" value="Jumlah Transaksi [scalar]  (PCR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="166" width="156" height="98" as="geometry"/></mxCell><mxCell id="ann" value="TUJUAN: Satu layar untuk menjawab: apakah Net Sales dan margin FY2025 dan H1 2026 berada di jalur target, dan seberapa lengkap datanya.&#xa;&#xa;PENGGUNA: Direktur Komersial (utama); Finance Controller (validasi margin dan angka).&#xa;&#xa;KEPUTUSAN: Keputusan 2 (channel/region mana diprioritaskan perbaikan) dan keputusan 1 (apakah tekanan margin menuntut realokasi promo).&#xa;&#xa;PERTANYAAN BISNIS: Q1 pencapaian vs target; Q2 tren dan kontribusi channel; Q3 margin.&#xa;&#xa;FILTER DASHBOARD: Periode, Channel, Region, Kategori" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="30" width="350" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Channel, Region &amp; Store" id="kirana_channel_region_store"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1380" pageHeight="1188"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Channel, Region &amp; Store: di mana kinerja berada di bawah target? [heading]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="30" width="956" height="30" as="geometry"/></mxCell><mxCell id="c3" value="**Drill-down.** Klik baris pada tabel *Achievement Store per region* untuk mengisi filter  [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="1050" width="956" height="64" as="geometry"/></mxCell><mxCell id="c4" value="Kesegaran data dan status sinkronisasi POS [table]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="64" width="956" height="98" as="geometry"/></mxCell><mxCell id="c5" value="Penanda data tidak lengkap per toko-bulan [table]  (P)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="846" width="476" height="200" as="geometry"/></mxCell><mxCell id="c6" value="Achievement bulanan per channel (%) [line]  (PCR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="166" width="476" height="234" as="geometry"/></mxCell><mxCell id="c7" value="Achievement Store per region (klik region untuk melihat tokonya) [table]  (PR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="166" width="476" height="234" as="geometry"/></mxCell><mxCell id="c8" value="Kontribusi channel terhadap Net Sales (%) [bar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="846" width="476" height="200" as="geometry"/></mxCell><mxCell id="c9" value="Kinerja per toko (klik toko untuk detail) [table]  (PR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="404" width="956" height="438" as="geometry"/></mxCell><mxCell id="ann" value="TUJUAN: Menemukan di mana kinerja di bawah target: channel, region, lalu toko (drill-down region -&gt; toko -&gt; detail toko), dan memisahkan toko bermasalah karena bisnis dari data.&#xa;&#xa;PENGGUNA: Head of Store Operations (utama); Direktur Komersial; Head of E-Commerce (channel online).&#xa;&#xa;KEPUTUSAN: Keputusan 2: toko atau region mana yang masuk program perbaikan kinerja H2 2026.&#xa;&#xa;PERTANYAAN BISNIS: Q1 pencapaian per channel, region, toko; Q2 pergeseran kontribusi channel; Q5 toko berkinerja rendah dan penyebabnya.&#xa;&#xa;FILTER DASHBOARD: Periode, Channel, Region, Kategori" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="30" width="350" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Margin &amp; Promosi" id="kirana_margin_promo"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1380" pageHeight="1188"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Margin &amp; Promosi: promo mana yang menguntungkan dan mana yang menggerus margin? [heading]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="30" width="956" height="30" as="geometry"/></mxCell><mxCell id="c3" value="**Catatan promo.** Lift dihitung terhadap baseline hari yang sama pada +/-1 s.d. 4 minggu  [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="1050" width="956" height="64" as="geometry"/></mxCell><mxCell id="c4" value="Kesegaran data dan status sinkronisasi POS [table]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="64" width="956" height="98" as="geometry"/></mxCell><mxCell id="c5" value="Contribution Margin bulanan per channel (%) [line]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="370" width="476" height="200" as="geometry"/></mxCell><mxCell id="c6" value="Diskon dan voucher terhadap gross sales per channel (%) [line]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="370" width="476" height="200" as="geometry"/></mxCell><mxCell id="c7" value="Dari Net Sales ke Contribution Margin per channel (% Net Sales) [bar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="166" width="476" height="200" as="geometry"/></mxCell><mxCell id="c8" value="Gross Margin per kategori (%) [row]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="166" width="476" height="200" as="geometry"/></mxCell><mxCell id="c9" value="Detail per kode promo [table]  (P)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="812" width="476" height="234" as="geometry"/></mxCell><mxCell id="c10" value="Margin kotor tambahan per jenis promo (Rp juta) [row]  (P)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="812" width="476" height="234" as="geometry"/></mxCell><mxCell id="c11" value="Efektivitas promo per jenis: lift dan dampak margin [table]  (P)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="574" width="956" height="234" as="geometry"/></mxCell><mxCell id="ann" value="TUJUAN: Menunjukkan siapa yang menekan margin (kategori, channel, biaya channel, diskon) dan promo mana yang tumbuh menguntungkan atau hanya membeli revenue dengan margin.&#xa;&#xa;PENGGUNA: Direktur Komersial (utama); Head of E-Commerce; Finance Controller.&#xa;&#xa;KEPUTUSAN: Keputusan 1: realokasi anggaran promo antar-channel, kategori, dan mekanisme promo.&#xa;&#xa;PERTANYAAN BISNIS: Q3 gross dan contribution margin; Q4 efektivitas promo.&#xa;&#xa;FILTER DASHBOARD: Periode, Channel, Region, Kategori" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="30" width="350" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Retur &amp; Customer" id="kirana_returns_customers"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1380" pageHeight="1086"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Retur &amp; Customer: mengapa barang kembali dan seberapa sering member berbelanja ulang? [heading]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="30" width="956" height="30" as="geometry"/></mxCell><mxCell id="c3" value="**Catatan.** Retur dikelompokkan menurut tanggal retur dan mengikuti atribut penjualan asa [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="948" width="956" height="64" as="geometry"/></mxCell><mxCell id="c4" value="Kesegaran data dan status sinkronisasi POS [table]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="64" width="956" height="98" as="geometry"/></mxCell><mxCell id="c5" value="Active Members bulanan per channel [line]  (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="472" width="476" height="200" as="geometry"/></mxCell><mxCell id="c6" value="Alasan retur (% nilai refund) [row]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="268" width="316" height="200" as="geometry"/></mxCell><mxCell id="c7" value="Cancellation Rate online [scalar]  (PCR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="166" width="236" height="98" as="geometry"/></mxCell><mxCell id="c8" value="Active Members dan Repeat Rate per tahun [table]  (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="676" width="476" height="268" as="geometry"/></mxCell><mxCell id="c9" value="Repeat Rate per semester dan channel (%) [bar]  (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="676" width="476" height="268" as="geometry"/></mxCell><mxCell id="c10" value="Return Rate (Rp) [scalar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="166" width="236" height="98" as="geometry"/></mxCell><mxCell id="c11" value="Return Rate bulanan per channel (%) [line]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="472" width="476" height="200" as="geometry"/></mxCell><mxCell id="c12" value="Return Rate per channel (%) [bar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="268" width="316" height="200" as="geometry"/></mxCell><mxCell id="c13" value="Return Rate per kategori (%) [row]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="268" width="316" height="200" as="geometry"/></mxCell><mxCell id="c14" value="Return Rate (unit) [scalar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="166" width="236" height="98" as="geometry"/></mxCell><mxCell id="c15" value="Void Rate POS [scalar]  (PCR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="166" width="236" height="98" as="geometry"/></mxCell><mxCell id="ann" value="TUJUAN: Mengukur tingkat dan alasan retur serta pembatalan/void, dan aktivitas serta repeat purchase member per channel.&#xa;&#xa;PENGGUNA: Head of Store Operations (Store); Head of E-Commerce (online).&#xa;&#xa;KEPUTUSAN: Keputusan 1 dan 2: kualitas channel/kategori yang layak ditambah anggaran promo atau diperbaiki.&#xa;&#xa;PERTANYAAN BISNIS: Q6 retur per kategori dan channel; Q7 aktivitas dan repeat member.&#xa;&#xa;FILTER DASHBOARD: Periode, Channel, Region, Kategori" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="30" width="350" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5. Storyline" id="kirana_storyline"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1380" pageHeight="1528"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Storyline: margin dan promo menentukan H2 2026, bukan volume [heading]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="30" width="956" height="30" as="geometry"/></mxCell><mxCell id="c3" value="**Ringkasan.** Net Sales memenuhi target (99,5% FY2025, 105,8% H1 2026) tetapi margin koto [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="166" width="956" height="64" as="geometry"/></mxCell><mxCell id="c4" value="### 1. Margin kotor turun 3,1 pt: HPP per unit naik 5,9%, harga neto hanya 1,5%

Bila HPP  [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="234" width="356" height="166" as="geometry"/></mxCell><mxCell id="c5" value="### 2. Contribution margin turun 4,2 pt: 3,3 pt margin dalam channel, 0,9 pt pergeseran ke [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="404" width="356" height="166" as="geometry"/></mxCell><mxCell id="c6" value="### 3. Target agregat tercapai hanya karena online: Marketplace 127,5% dan Mobile App 124, [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="574" width="356" height="166" as="geometry"/></mxCell><mxCell id="c7" value="### 4. Mega Sale dan Clearance menggerus margin; App Payday menambahnya di 27 dari 27 kode [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="744" width="356" height="166" as="geometry"/></mxCell><mxCell id="c8" value="### 5. Hanya MDN-01 konsisten di bawah target tanpa penjelasan lain; SBY-02, MLG-01, SOL-0 [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="914" width="356" height="302" as="geometry"/></mxCell><mxCell id="c9" value="### 6. Fashion online mengembalikan 15,1% penjualannya (Store 2,8%); 57% refund Fashion ka [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="1220" width="356" height="166" as="geometry"/></mxCell><mxCell id="c10" value="**Anotasi pengukuran.** BGR-01 pindah ke Jabodetabek pada 1 Jul 2025 tetapi target FY2025  [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="1390" width="956" height="64" as="geometry"/></mxCell><mxCell id="c11" value="Kesegaran data dan status sinkronisasi POS [table]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="64" width="956" height="98" as="geometry"/></mxCell><mxCell id="c12" value="Gross dan Contribution Margin bulanan (%) [line]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="234" width="596" height="166" as="geometry"/></mxCell><mxCell id="c13" value="Dari Net Sales ke Contribution Margin per channel (% Net Sales) [bar]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="404" width="596" height="166" as="geometry"/></mxCell><mxCell id="c14" value="Pencapaian terhadap target per channel [table]  (PCR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="574" width="596" height="166" as="geometry"/></mxCell><mxCell id="c15" value="Margin kotor tambahan per jenis promo (Rp juta) [row]  (P)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="744" width="596" height="166" as="geometry"/></mxCell><mxCell id="c16" value="Kinerja per toko (klik toko untuk detail) [table]  (PR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="914" width="596" height="302" as="geometry"/></mxCell><mxCell id="c17" value="Return Rate per kategori (%) [row]  (PCRK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="1220" width="596" height="166" as="geometry"/></mxCell><mxCell id="ann" value="TUJUAN: Menyajikan 4-6 temuan terkuantifikasi berjudul asertif beserta rekomendasi, merujuk kartu pada tab 1-4.&#xa;&#xa;PENGGUNA: Direktur Komersial.&#xa;&#xa;KEPUTUSAN: Kedua keputusan H2 2026.&#xa;&#xa;PERTANYAAN BISNIS: Seluruh Q1-Q7 (ringkasan).&#xa;&#xa;FILTER DASHBOARD: Periode, Channel, Region, Kategori" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="30" width="350" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Detail Toko" id="detail_toko_detail"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1380" pageHeight="644"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Detail Toko: tren, kategori, dan kelengkapan data satu toko [heading]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="30" width="956" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Kembali ke dashboard utama lewat menu koleksi *KIRANA BI*. Target toko adalah alokasi (asu [text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="540" width="956" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Net Sales per kategori (Rp juta) [row]  (PT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="166" width="476" height="200" as="geometry"/></mxCell><mxCell id="c5" value="Kelengkapan data toko per bulan [table]  (PT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="370" width="956" height="166" as="geometry"/></mxCell><mxCell id="c6" value="Ringkasan toko [table]  (PT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="64" width="956" height="98" as="geometry"/></mxCell><mxCell id="c7" value="Net Sales vs target alokasi bulanan (Rp juta) [line]  (PT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="10" y="166" width="476" height="200" as="geometry"/></mxCell><mxCell id="ann" value="TUJUAN: Drill-down satu toko: tren terhadap target alokasi, bauran kategori, dan kelengkapan data (dibuka dengan klik toko).&#xa;&#xa;PENGGUNA: Head of Store Operations.&#xa;&#xa;KEPUTUSAN: Keputusan 2: apakah satu toko layak masuk program perbaikan atau hanya terdampak kejadian/data.&#xa;&#xa;PERTANYAAN BISNIS: Q5 toko berkinerja rendah dan penyebabnya (bisnis atau data).&#xa;&#xa;FILTER DASHBOARD: Periode, Toko" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="30" width="350" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
